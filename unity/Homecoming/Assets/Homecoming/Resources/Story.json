{
  "prologue": [
    {
      "id": "opening",
      "seconds": 27.2,
      "description": "The AUK Space Apps Kuwait intro video plays before the story begins.",
      "cues": []
    },
    {
      "id": "signal",
      "description": "A pinprick in the dark becomes the Moon as the camera races toward it. A radio signal crackles.",
      "seconds": 4.5,
      "cues": [
        {
          "at": 0.08,
          "name": "radio"
        },
        {
          "at": 2.9,
          "name": "orbit"
        }
      ]
    },
    {
      "id": "apollo",
      "description": "Apollo 11 television footage shows an astronaut beside the lunar module in 1969.",
      "label": "1969",
      "seconds": 5.7,
      "cues": []
    },
    {
      "id": "reveal",
      "description": "The picture shrinks into a flickering television. On an alien ship, Zorvax springs forward to greet the astronaut.",
      "seconds": 4.2,
      "lines": [
        {
          "id": "reveal.01",
          "at": 2,
          "end": 4.2,
          "text": "Zorvax: They left Earth! They’re coming!"
        }
      ],
      "cues": [
        {
          "at": 1.3,
          "name": "orbit"
        }
      ]
    },
    {
      "id": "correction",
      "description": "Nyxen holds up one finger. Zorvax throws his arms wide anyway.",
      "seconds": 3.6,
      "lines": [
        {
          "id": "correction.01",
          "at": 0.3,
          "end": 1.75,
          "text": "Nyxen: Sir, that’s one human."
        },
        {
          "id": "correction.02",
          "at": 1.75,
          "end": 3.6,
          "text": "Zorvax: The first of many!"
        }
      ],
      "cues": []
    },
    {
      "id": "party",
      "description": "The cadet fires the party cannon. The lights go rose and teal, foil strips fly, and the crew dances beneath a welcome banner.",
      "seconds": 4.4,
      "lines": [
        {
          "id": "party.01",
          "at": 0,
          "end": 0.72,
          "text": "Zorvax: Cadet!"
        },
        {
          "id": "party.burst",
          "at": 0.72,
          "end": 2.15,
          "text": "[Party cannon pops]"
        }
      ],
      "cues": [
        {
          "at": 0.72,
          "name": "party-hit"
        },
        {
          "at": 1.0,
          "name": "celebrate"
        }
      ]
    },
    {
      "id": "jam",
      "description": "One last streamer lodges in the cannon. The cannon coughs twice.",
      "seconds": 2.6,
      "lines": [
        {
          "id": "jam.coughs",
          "at": 0.58,
          "end": 1.3,
          "text": "[Cannon coughs twice]"
        },
        {
          "id": "jam.01",
          "at": 1.3,
          "end": 2.6,
          "text": "Cadet B: It’s… resting."
        }
      ],
      "cues": [
        {
          "at": 0.58,
          "name": "sputter"
        },
        {
          "at": 1.08,
          "name": "sputter"
        }
      ]
    },
    {
      "id": "years",
      "description": "The bridge holds in the same frame. The lights fade and the banner sags. In 2026, 57 years later, the crew is still waiting.",
      "label": "2026",
      "seconds": 6.4,
      "lines": [
        {
          "id": "years.01",
          "at": 3.1,
          "end": 4.7,
          "text": "Cadet B: Take the banner down?"
        },
        {
          "id": "years.02",
          "at": 4.7,
          "end": 6.4,
          "text": "Zorvax: When they get here."
        }
      ],
      "cues": [
        {
          "at": 0.18,
          "name": "rattle"
        }
      ]
    },
    {
      "id": "return",
      "description": "The CRT lights up. Artemis II flew around the Moon and returned its crew to Earth. Zorvax turns toward the observation window.",
      "seconds": 4.8,
      "lines": [
        {
          "id": "return.01",
          "at": 1.5,
          "end": 3.2,
          "text": "Zorvax: The Moon? Again?"
        },
        {
          "id": "return.02",
          "at": 3.2,
          "end": 4.8,
          "text": "Nyxen: Then straight back home, sir."
        }
      ],
      "cues": [
        {
          "at": 0.18,
          "name": "radio"
        }
      ]
    },
    {
      "id": "earth",
      "description": "Through the window, Earth rolls out of the night and into the sunlight. Zorvax takes a long look at the planet humans keep coming home to.",
      "seconds": 5.0,
      "lines": [
        {
          "id": "earth.01",
          "at": 3.1,
          "end": 5,
          "text": "Zorvax: What does it have that ours doesn’t?"
        }
      ],
      "cues": [
        {
          "at": 0.3,
          "name": "orbit"
        }
      ]
    },
    {
      "id": "launch",
      "description": "In the gloom, Zorvax slams a red switch. Every light on the bridge kicks on.",
      "seconds": 2.6,
      "lines": [
        {
          "id": "launch.01",
          "at": 1,
          "end": 2.6,
          "text": "Zorvax: Let’s find out."
        }
      ],
      "cues": [
        {
          "at": 0.74,
          "name": "detent"
        }
      ]
    },
    {
      "id": "title",
      "description": "Operation: The Great Homecoming.",
      "seconds": 3.4,
      "cues": [
        {
          "at": 0.14,
          "name": "discover"
        }
      ]
    }
  ],
  "briefing": [
    {
      "id": "lab",
      "description": "Nyxen activates a miniature Earth on the research bench, then points to a weather control.",
      "seconds": 6.4,
      "lines": [
        {
          "id": "lab.01",
          "at": 1.6,
          "end": 4.2,
          "text": "Nyxen: A working copy of Earth."
        },
        {
          "id": "lab.02",
          "at": 4.2,
          "end": 6.4,
          "text": "Nyxen: Try this dial."
        }
      ],
      "cues": [
        {
          "at": 0.45,
          "name": "projector"
        },
        {
          "at": 1.5,
          "name": "orbit"
        }
      ]
    }
  ],
  "ending": [
    {
      "id": "hearing",
      "description": "Zorvax presents your report and reaches for the party cannon. Nyxen points to the evidence labels. Zorvax lowers his hand.",
      "seconds": 5.8,
      "lines": [
        {
          "id": "hearing.01",
          "at": 0.7,
          "end": 2.5,
          "text": "Zorvax: Proof! Now they’ll come!"
        },
        {
          "id": "hearing.02.scenario",
          "at": 2.5,
          "end": 5.15,
          "text": "Nyxen: Sir, we ran a simulation.",
          "variant": "scenario"
        },
        {
          "id": "hearing.02.historical",
          "at": 2.5,
          "end": 5.15,
          "text": "Nyxen: Sir, these are weather records.",
          "variant": "historical"
        },
        {
          "id": "hearing.02.mixed",
          "at": 2.5,
          "end": 5.15,
          "text": "Nyxen: Weather records here. Simulation here.",
          "variant": "mixed"
        }
      ],
      "cues": [
        {
          "at": 0.6,
          "name": "paper"
        }
      ]
    },
    {
      "id": "deflate",
      "description": "The jammed streamer stays put. The last party balloon deflates next to the cannon.",
      "seconds": 4.4,
      "lines": [
        {
          "id": "deflate.squeak",
          "at": 0.84,
          "end": 2.65,
          "text": "[Balloon squeaks]"
        },
        {
          "id": "deflate.01",
          "at": 2.8,
          "end": 4.4,
          "text": "Cadet B: …Same time next year?"
        }
      ],
      "cues": [
        {
          "at": 0.84,
          "name": "deflate"
        }
      ]
    }
  ]
}
